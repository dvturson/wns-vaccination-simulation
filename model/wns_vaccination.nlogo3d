globals [mode month carrying-capacity total-population immunity-loss-rate]

turtles-own [infection-status days-exposed falling? vaccinated? days-vaccinated]

to setup
  clear-all
  set month vaccination_month
  set mode "swarming"
  set immunity-loss-rate (1 / 365)
;  set immunity-loss-rate 0

  set carrying-capacity (number-of-drawers / 0.745)
  print (word "Starting Population: " number-of-drawers)
  print (word "Carrying Capacity: " carrying-capacity)

  create-turtles number-of-drawers [
    set size 3
    set color white
    set infection-status "susceptible"
    set falling? false
    set vaccinated? false
    set days-vaccinated 0

    ;; Random placement
    let chance (random 10) + 1
    ifelse chance < 10 [
      setxyz ((random 160) - 80) 70 + (random 8) - 4 ((random 160) - 80)
    ] [
      setxyz ((random 160) - 80) 50 + (random 20) - 4 ((random 160) - 80)
    ]
  ]

  randomly-infect-bats
  reset-ticks
end

to go
  manage-months

  if ticks > 0 and ticks mod 30 = 0 [
    print (word month " - " mode)
    print-population-count
  ]

  natural-mortality
  manage-infections
  set total-population count turtles

  ask turtles [
    if falling? [ fall-and-die ]
    if not falling? [
      if mode = "swarming" [ set size 3 wander ]
      if mode = "hibernation" [ wander hibernate spread-infection ]
      if mode = "roosting" [ wander roost ]
    ]
  ]
  tick
  update-plot2
  update-plot

  if ticks >= 3650 [
    print "Simulation ended at 10 years (3650 ticks)."
    stop
  ]

end

to update-plot
  set-current-plot "Bat Population"

  set-current-plot-pen "Total Population"
  plotxy ticks total-population

  set-current-plot-pen "Susceptible"
  plotxy ticks count turtles with [infection-status = "susceptible"]

  set-current-plot-pen "Exposed"
  plotxy ticks count turtles with [infection-status = "exposed"]

  set-current-plot-pen "Infected"
  plotxy ticks count turtles with [infection-status = "infected"]

  set-current-plot-pen "Cured"
  plotxy ticks count turtles with [infection-status = "cured"]
end

to update-plot2
  set-current-plot "Bat Population (total)"

  set-current-plot-pen "Total Population"
  plotxy ticks total-population
end

to print-population-count
  let susceptible-count count turtles with [infection-status = "susceptible"]
  let exposed-count count turtles with [infection-status = "exposed"]
  let infected-count count turtles with [infection-status = "infected"]
  let cured-count count turtles with [infection-status = "cured"]

  show (word "Total: " total-population ", Susceptible: " susceptible-count ", Exposed: " exposed-count ", Infected: " infected-count ", Cured: " cured-count)
  print ""
end

to apply-vaccination
  let num-to-vaccinate (vaccination-rate * count turtles with [infection-status != "infected" and infection-status != "cured"])

  print-population-count
  print (word "Eligible for vaccination: " count turtles with [infection-status != "infected" and infection-status != "cured"])
  print (word "Number to vaccinate: " num-to-vaccinate)

  ask n-of num-to-vaccinate turtles with [infection-status != "infected" and infection-status != "cured"] [
      set vaccinated? true
      set color green
      set infection-status "cured"
      set days-vaccinated 0
    ]

  ;; immunity loss
  ask turtles with [vaccinated?] [
    set days-vaccinated days-vaccinated + 1
    if random-float 1 < immunity-loss-rate [
      set vaccinated? false
      set color white
      set infection-status "susceptible"
    ]
  ]
end

to randomly-infect-bats
  ask n-of 2 turtles [
    set infection-status "exposed"
    set color red
    set days-exposed 0
  ]
end

to manage-months
  let months ["August" "September" "October" "November" "December" "January" "February" "March" "April" "May" "June" "July"]
  if ticks > 0 and ticks mod 30 = 0 [
    let index position month months
    set month item ((index + 1) mod length months) months

    if member? month ["August" "September"] [
      set mode "swarming"
    ]
    if member? month ["October" "November" "December" "January" "February" "March" "April"] [
      set mode "hibernation"
    ]

    if member? month ["May" "June" "July"] [
      set mode "roosting"
    ]

    if month = vaccination_month [ apply-vaccination print "APPLIED"]
  ]
end

to manage-infections
  ;; Handle infected bats
  ask turtles with [infection-status = "exposed"] [
    set days-exposed days-exposed + 1

    ;; Transition from latent to infectious
    if (mode = "hibernation" and days-exposed > 83) [
      set infection-status "infected"
      set color red
    ]
    if (mode = "swarming" and days-exposed > 120) [
      set infection-status "infected"
      set color red
    ]
  ]
  ask turtles with [infection-status = "infected"] [
    ;; Mortality rate (1/60 days)
    if random-float 1 < (1 / 60) [ fall-and-die ]
  ]
end

to spread-infection
  ask turtles with [infection-status = "susceptible"] in-radius 1 [
    if (mode = "hibernation") and random-float 1 < 0.004826 * 3 [
      set infection-status "exposed"
      set color yellow
      set days-exposed 0
    ]
  ]
end

to natural-mortality
  ask turtles [
    ;; Natural mortality (1 death per 8.5 * 365 days)
    if random-float 1 < (1 / (8.5 * 365)) [
;      print "natural death"
      fall-and-die
    ]
  ]
end

to fall-and-die
  if falling? = false [
    set falling? true
;    print "a bat is falling!"
  ]

  ;; Keep ycor constant
  set heading heading + (random 5) - 2
  set pitch pitch + (random 3) - 1
  set roll roll + (random 2) - 1
  fd 0.3
  rt (random 30) - 15
  tilt-up (random 50) - 20

  if ycor > min-pycor + 5 [
    set ycor ycor - 1.4  ;; fall speed
  ]

  ;; Once the bat reaches the bottom, it dies
  if ycor <= min-pycor + 5 [
    die
  ]
end

to hibernate
  let slow-speed 0.1
  set ycor ycor + (random-float 1)
  set xcor xcor + (random-float 0.2) - 0.1
  set zcor zcor + (random-float 0.2) - 0.1

  set heading heading + (random 5) - 2
  set pitch pitch + (random 3) - 1
  set roll roll + (random 2) - 1

  fd slow-speed
end

to roost
  ;; Bats have a small chance to reproduce
  if total-population < carrying-capacity and random 260 < 1 [
    hatch 1 [ set size 1 set color white set infection-status "susceptible" ]
  ]
end

to wander
  let speed 0
  let radius 0

  ifelse ycor > (max-pycor * 0.7) [
    set radius 1
    set speed 0.5
    set heading heading + (random 5) - 2
    set pitch pitch + (random 5) - 2
    set roll roll + (random 2) - 5
  ] [
    set radius 20
    set speed 1
    set heading heading + (random 10) - 5
    set pitch pitch + (random 10) - 5
    set roll roll + (random 5) - 10
    set ycor ycor + (random-float 0.1)
  ]

  fd speed
  rt (random 30) - 15
  tilt-up (random 50) - 20

  let close-bats turtles in-radius radius
  if any? close-bats [
    set heading heading + (random 90) - 45
  ]

  check-boundary
end


to check-boundary
  if xcor > max-pxcor - 5 [ set xcor max-pxcor - 5 set heading (heading + 180) ]
  if xcor < (- max-pxcor + 5) [ set xcor (- max-pxcor + 5) set heading (heading + 180) ]

  if ycor > max-pycor - 5 [ set ycor max-pycor - 5 set pitch (pitch + 180) ]
  if ycor < min-pycor + 5 [ set ycor (- max-pycor + 5) set pitch (pitch + 180) ]

  if zcor > max-pzcor - 5 [ set zcor max-pzcor - 5 set roll (roll + 180) ]
  if zcor < (- max-pzcor + 5) [ set zcor (- max-pzcor + 5) set roll (roll + 180) ]
end
